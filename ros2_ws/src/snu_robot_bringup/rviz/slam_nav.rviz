Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.25
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Map
      Topic:
        Value: /map
      Update Topic:
        Value: /map_updates
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 0; 0
      Enabled: true
      Name: LaserScan
      Size (m): 0.03
      Style: Points
      Topic:
        Value: /scan
    - Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Name: Global Plan
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/Pose
      Color: 255; 128; 0
      Enabled: true
      Name: Target Pose Base
      Shape: Arrow
      Topic:
        Value: /target_pose_base
    - Class: rviz_default_plugins/Pose
      Color: 80; 180; 255
      Enabled: true
      Name: Robot Pose Map
      Shape: Arrow
      Topic:
        Value: /robot_pose_map
    - Class: rviz_default_plugins/Pose
      Color: 255; 230; 80
      Enabled: true
      Name: Object Pose Map
      Shape: Arrow
      Topic:
        Value: /object_pose_map
    - Class: rviz_default_plugins/Pose
      Color: 80; 255; 120
      Enabled: true
      Name: BBox Goal Pose
      Shape: Arrow
      Topic:
        Value: /bbox_goal_pose
    - Class: rviz_default_plugins/PointCloud2
      Color: 255; 80; 80
      Enabled: true
      Name: Semantic Obstacles
      Size (m): 0.08
      Style: Spheres
      Topic:
        Value: /semantic_obstacle_cloud
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.2
      Target Frame: map
      Yaw: 0.7
Window Geometry:
  Height: 900
  Width: 1400
