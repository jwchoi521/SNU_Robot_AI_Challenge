<?xml version="1.0"?>
<package format="3">
  <name>snu_robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration package for SNU Robot SLAM and navigation.</description>
  <maintainer email="team@example.com">SNU Robot AI Challenge Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>robot_nav_stack</exec_depend>
  <exec_depend>robot_object_detector_ros</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>snu_base_control</exec_depend>
  <exec_depend>snu_mission_manager</exec_depend>
  <exec_depend>snu_target_navigation</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
